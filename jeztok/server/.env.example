# Ježtok backend – konfigurace (zkopírujte jako .env, nebo nastavte v prostředí)

# Port serveru
PORT=8790

# Odkud smí frontend volat (adresa webu s aplikací; více adres oddělte čárkou)
ALLOWED_ORIGIN=https://nadinensmark-bot.github.io

# Databáze. Bez DATABASE_URL se použije SQLite v souboru DB_PATH (výchozí ./data/jeztok.sqlite).
# POZOR: na Render free tieru je disk efemérní – SQLite se při každém nasazení smaže.
# Pro trvalá data nastavte DATABASE_URL na Postgres (např. Neon, Supabase, Render Postgres).
DATABASE_URL=
DB_PATH=./data/jeztok.sqlite

# Tajemství pro podepisování session tokenů (libovolný dlouhý náhodný řetězec)
SESSION_SECRET=

# VOLITELNÉ: Anthropic API klíč – zapne AI dovysvětlení a generování kurzů z poznámek.
# Bez klíče vše ostatní funguje (účty, postup, testy, ruční import kurzů).
ANTHROPIC_API_KEY=

# Modely (výchozí: Claude Opus 5.5 pro obojí). Přepnout lze např. na claude-sonnet-5-5.
MODEL_VYSVETLI=claude-opus-5-5
MODEL_KURZ=claude-opus-5-5

# Denní limity AI (na uživatele) a celkový strop volání za den
LIMIT_VYSVETLI_DEN=40
LIMIT_KURZ_DEN=5
LIMIT_AI_CELKEM_DEN=1000

# Testovací režim bez volání Claude API (1 = zapnuto; AI endpointy vrací ukázkové odpovědi)
MOCK_AI=
