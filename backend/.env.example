# DH Kompas backend – konfigurace (zkopírujte jako .env, nebo nastavte v prostředí)

# POVINNÉ: API klíč z Anthropic Console (console.anthropic.com).
# Doporučení: vytvořit samostatný workspace "DH Kompas" a nastavit mu
# měsíční spend limit – tvrdý strop nákladů nad rámec limitů níže.
ANTHROPIC_API_KEY=

# Odkud smí frontend volat (adresa webu s aplikací)
ALLOWED_ORIGIN=https://nadinensmark-bot.github.io

# Port serveru
PORT=8787

# Modely (výchozí volba dle zadání: levný chat, silnější analýza)
MODEL_CHAT=claude-haiku-4-5
MODEL_ANALYZA=claude-sonnet-5

# Stropy odpovědí (v tokenech)
CHAT_MAX_TOKENS=1024
ANALYZA_MAX_TOKENS=4096

# Denní limity
LIMIT_CHAT_DEN=20
LIMIT_ANALYZA_DEN=3
LIMIT_CELKEM_DEN=500

# Volitelné: přímý odkaz na ZIP s knowledge base (pro hosting bez disku).
# Např. https://drive.google.com/uc?export=download&id=ID_SOUBORU
KNOWLEDGE_ZIP_URL=

# Testovací režim bez volání API (1 = zapnuto)
MOCK_AI=
